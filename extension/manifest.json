{
  "manifest_version": 3,
  "name": "RefExplain AI",
  "version": "1.0.0",
  "description": "Understand controversial sports referee decisions with AI without leaving the match.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RefExplain AI"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}

